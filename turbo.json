{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "20",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:en": {
      "dependsOn": ["build"],
      "outputs": ["dist/en/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:en": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    }
  }
}

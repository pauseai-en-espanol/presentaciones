{
  "name": "pauseai-es-presentaciones",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Coleccion de presentaciones PauseAI España",
  "scripts": {
    "dev": "turbo run dev dev:en",
    "build": "turbo run build build:en",
    "card": "pnpm --filter @pauseai-es/cards card",
    "video": "pnpm --filter @pauseai-es/video video",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "check": "pnpm lint && pnpm format:check",
    "release:note": "changeset add",
    "release:empty": "changeset add --empty",
    "release:bump": "changeset version",
    "release:check": "changeset status --since=origin/main",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@slango.configs/lint-staged": "2.0.11",
    "@slango.configs/oxlint": "0.1.16",
    "@slango.configs/prettier": "1.0.38",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": "^26.12.1",
    "pnpm": "^12.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}

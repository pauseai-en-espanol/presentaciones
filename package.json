{
  "name": "pauseai-es-presentaciones",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Coleccion de presentaciones PauseAI España",
  "scripts": {
    "dev": "turbo run dev dev:en",
    "build": "turbo run build build:en",
    "card": "pnpm --filter @pauseai-es/cards card",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "format": "prettier --ignore-unknown --write .",
    "check": "pnpm lint && prettier --ignore-unknown --check .",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@slango.configs/lint-staged": "2.0.5",
    "@slango.configs/oxlint": "0.1.6",
    "@slango.configs/prettier": "1.0.32",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "turbo": "2.11.4"
  },
  "engines": {
    "node": "^26.11.1",
    "pnpm": "^12.8.1"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  }
}
